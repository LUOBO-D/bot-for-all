# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # fill in every REQUIRED value below, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Generate secrets (hex only — the values are also interpolated into a URL and
# into MySQL's own CLI flags, where base64 characters would break things):
#
#   openssl rand -hex 24   # MYSQL_ROOT_PASSWORD
#   openssl rand -hex 24   # MYSQL_APP_PASSWORD
#   openssl rand -hex 32   # JWT_SECRET
#   openssl rand -hex 32   # BOT_KEY_SECRET
#   openssl rand -hex 16   # ADMIN_PASSWORD
#
# This file is read both by Compose (interpolation) and by the backend
# container (env_file). Never commit the filled-in copy.

# REQUIRED. MySQL root password. Hex only: Compose embeds it in DATABASE_URL.
# Root is confined to MySQL container initialization (healthcheck).
MYSQL_ROOT_PASSWORD=

# REQUIRED. Non-root business account the backend connects as
# (mysql://chat_app:...@mysql:3306/chat). Created by db/init/01-app-user.sh on
# first initialization of the MySQL data volume. Hex only: Compose embeds it
# in DATABASE_URL, and the init script interpolates it into a SQL literal.
# Rotating: change the value and run the CREATE USER / ALTER USER / GRANT from
# the script manually (init scripts only run on a fresh volume).
MYSQL_APP_PASSWORD=

# REQUIRED. At least 32 characters; the server refuses to boot otherwise.
JWT_SECRET=

# REQUIRED. Exactly 64 lowercase hex characters (32 bytes). Encrypts bot API
# keys at rest — rotating it makes previously stored keys undecryptable.
BOT_KEY_SECRET=

ADMIN_USERNAME=admin

# REQUIRED. Password for the seeded admin account (pnpm seed:admin); no default.
ADMIN_PASSWORD=

# Optional. Only needed when the browser calls the API from a different origin
# than the one serving the SPA; same-origin deployments can leave it unset.
# CORS_ORIGIN=https://chat.example.com

# Optional. Redis URL for shared rate-limit counters. docker-compose.prod.yml
# already sets it to the bundled `redis` service; leave this unset there.
# Without it the backend keeps rate-limit counters in process memory.
# REDIS_URL=redis://redis:6379

# Optional runtime tuning (defaults shown; see .env.example for the full list).
# CAPTCHA_ENABLED=true
# RATE_LIMIT_ENABLED=true
# BOT_TIMEOUT_MS=60000
# BOT_CONTEXT_MESSAGES=20
# BOT_CONTEXT_MAX_CHARS=6000
# BOT_RATE_PER_MIN=20
# BOT_DEBOUNCE_MS=2000
# BOT_THROTTLE_MS=80
