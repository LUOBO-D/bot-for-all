# Copy to .env and fill in every value marked REQUIRED before starting the server.
PORT=3000
DATABASE_URL=mysql://root:devroot@127.0.0.1:3306/chat

# REQUIRED. At least 32 characters; the server refuses to boot with a shorter or missing value.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED. 64 lowercase hex characters (32 bytes) used to encrypt bot API keys.
# Generate with: openssl rand -hex 32
# All-zero / single-repeated-character values are rejected.
BOT_KEY_SECRET=

ADMIN_USERNAME=admin
# REQUIRED. Password for the seeded admin account; no default is applied.
# Generate with: openssl rand -hex 16
ADMIN_PASSWORD=

CAPTCHA_ENABLED=true
RATE_LIMIT_ENABLED=true

# Local demo only: allow bot base URLs that point at loopback/private networks
# (e.g. Ollama on http://127.0.0.1:11434). Set to false in production.
ALLOW_PRIVATE_BOT_URLS=true

# Express "trust proxy" setting: false (default), true, a hop count (1), or a
# trust list ("loopback"). Enable only when running behind a reverse proxy.
TRUST_PROXY=false

# Optional: directory for uploaded room attachments. Defaults to backend/uploads.
# UPLOAD_DIR=./uploads

# Per-user attachment quota in bytes. Default 209715200 (200 MiB); 0 disables it.
# Counts every attachment the user uploaded, including unsent and withdrawn ones.
ATTACHMENT_USER_QUOTA_BYTES=209715200

# Hard cap on the number of attachment rows one user may own, covering uploads
# and files copied by forwarding. Default 1000, range 1..100000. Exceeding it
# returns 413 ATTACHMENT_QUOTA_EXCEEDED and deletes the file that just landed.
ATTACHMENT_USER_MAX_FILES=1000

# Orphaned attachment cleanup. Unbound uploads and attachments of withdrawn
# messages older than this TTL (in hours, 1..8760) are deleted, at most 500
# rows per sweep. The sweep runs once at startup and then every interval
# (milliseconds, 60000..86400000; default 6 hours).
ATTACHMENT_ORPHAN_TTL_HOURS=24
ATTACHMENT_CLEANUP_INTERVAL_MS=21600000

# Per-room message retention. Rooms with a retention policy (retentionDays > 0)
# drop messages older than their configured window; pinned messages are kept.
# The sweep runs once at startup and then every interval below (milliseconds,
# 60000..86400000; default 6 hours). At most 500 messages per sweep.
ROOM_RETENTION_SWEEP_MS=21600000

# Row cap for GET /api/admin/audit/export-all, the streaming full audit export.
# Default 100000, range 1..1000000. The CSV is streamed in keyset batches; when
# more rows match the filter the response carries X-Audit-Truncated: true.
# Each admin may download it once per five minutes.
AUDIT_EXPORT_ALL_MAX=100000

BOT_TIMEOUT_MS=60000
BOT_CONTEXT_MESSAGES=20
BOT_CONTEXT_MAX_CHARS=6000
BOT_RATE_PER_MIN=20
BOT_DEBOUNCE_MS=2000
BOT_THROTTLE_MS=80

# Bot creation quotas. One room may hold at most this many room-scoped bots
# (1..50), and one user may own at most this many bots across all rooms and
# global bots (1..100). Rows are counted regardless of enabled state because
# disabling is a soft delete. Creation is also limited to 10 attempts/minute
# per user; over-quota creations return 400 BOT_LIMIT_REACHED, over-rate 429.
BOT_MAX_PER_ROOM=10
BOT_MAX_PER_OWNER=20

# Provider response byte caps, enforced on bytes actually read (never on
# Content-Length). The first cap covers JSON/text bodies, error bodies and the
# total of an SSE stream (64 KiB..16 MiB); the second caps one SSE event and
# the unfinished-event buffer (16 KiB..1 MiB). Exceeding either cancels the
# connection and fails the bot turn with 502 BOT_RESPONSE_TOO_LARGE.
BOT_MAX_RESPONSE_BYTES=1048576
BOT_MAX_SSE_EVENT_BYTES=262144

# Optional message translation via an OpenAI-compatible endpoint. Translation
# is enabled only when BASE_URL, API_KEY and MODEL are all non-empty; otherwise
# POST /api/rooms/:id/messages/:seq/translate returns 503 TRANSLATION_DISABLED.
# BASE_URL is used verbatim as `${TRANSLATE_BASE_URL}/chat/completions`, so
# include any version prefix (e.g. http://127.0.0.1:11434/v1).
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
# Wall-clock budget for one request, including the response body read.
TRANSLATE_TIMEOUT_MS=15000
# In-process cache of successful translations, keyed by message id, edit
# timestamp and target language. A hit is served without calling the provider;
# 0 disables the cache. TRANSLATE_CACHE_MAX caps entries (1..5000) and evicts
# the least recently used one. Failures are never cached.
TRANSLATE_CACHE_TTL_MS=3600000
TRANSLATE_CACHE_MAX=500
